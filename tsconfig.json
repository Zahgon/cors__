{
  "compilerOptions": {
    "target": "ES5",
    "lib": ["ES2015"],
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "noImplicitAny": false,
    "esModuleInterop": false,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "declaration": true,
    "sourceMap": true,
    "types": ["node", "mocha"],
    "noEmit": true
  },
  "include": ["lib/**/*.ts", "test/**/*.ts"]
}

{
  "name": "cors",
  "description": "Node.js CORS middleware",
  "version": "2.8.6",
  "author": "Troy Goode <troygoode@gmail.com> (https://github.com/troygoode/)",
  "license": "MIT",
  "keywords": [
    "cors",
    "express",
    "connect",
    "middleware"
  ],
  "repository": "expressjs/cors",
  "funding": {
    "type": "opencollective",
    "url": "https://opencollective.com/express"
  },
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "dependencies": {
    "object-assign": "^4",
    "vary": "^1"
  },
  "devDependencies": {
    "@types/express": "4.17.21",
    "@types/mocha": "9.1.1",
    "@types/node": "18.19.50",
    "@types/supertest": "2.0.16",
    "after": "0.8.2",
    "express": "4.21.2",
    "mocha": "9.2.2",
    "nyc": "15.1.0",
    "supertest": "6.1.3",
    "ts-node": "10.9.2",
    "typescript": "4.9.5"
  },
  "files": [
    "lib/index.js",
    "lib/index.d.ts"
  ],
  "engines": {
    "node": ">= 0.10"
  },
  "scripts": {
    "prepare": "npm run build",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && npm run test-ci",
    "test-ci": "nyc --reporter=lcov --reporter=text mocha --require ts-node/register --require test/support/env.ts test/*.ts"
  },
  "nyc": {
    "include": [
      "lib/**/*.js"
    ],
    "sourceMap": false,
    "all": true
  }
}
